  "keywords": [
    "video",
    "motion-design",
    "motion-graphics",
    "animation",
    "webgpu",
    "ai-agents",
    "claude",
    "after-effects",
    "video-editor",
    "mp4",
    "templates"
  ],
  "homepage": "https://greenlightdash.pro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpsoul/greenlight-motion-engine.git",
    "directory": "motion-engine"
  },
  "bugs": {
    "email": "support@greenlightdash.pro"
  },
  "author": "WPSOUL",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "greenlight-motion": "cli/index.mjs"
  },
